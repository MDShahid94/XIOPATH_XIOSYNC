# XIOSYNC frontend environment (doc 08). No secrets ever live here — the
# frontend holds no signing keys and stores no tokens on disk (INV-FE-1).

# Base path of the generated API client. Same-origin by default so the dev
# proxy (vite.config.ts) forwards to the API and session cookies stay first-party.
VITE_API_BASE_URL=/api/v1

# WebSocket endpoint. Auth happens in the handshake, never a ?token= query (INV-FE-2).
VITE_WS_URL=/ws

# Dev-only proxy targets consumed by vite.config.ts (never shipped to the client).
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WS_PROXY_TARGET=http://localhost:8000
